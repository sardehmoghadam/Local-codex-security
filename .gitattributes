*.cjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.mts text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# The MCP launcher has no extension, so the extension rules above miss it. A
# CRLF shebang makes exec fail with ENOENT when the bundled plugin runs inside
# the Linux image build.
plugins/codex-security/scripts/launch_codex_security_mcp text eol=lf

# Bundled dependencies contain intentional whitespace in strings and comments.
github-action/dist/*.cjs linguist-generated=true -whitespace

# This checksum-pinned upstream license contains its original whitespace.
docker/wolfi/payload/notices/BUBBLEWRAP-COPYING -text -whitespace
